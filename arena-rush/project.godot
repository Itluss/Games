[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="mob"
3d_physics/layer_4="projectile"
3d_physics/layer_5="pickup"

[physics]

; 90 Hz plutôt que 60 : le corps est simulé par pas de physique, mais
; affiché à une cadence variable — surtout en navigateur. Des pas plus
; rapprochés réduisent d'autant l'escalier perceptible sur le mouvement.
; Le coût est faible ici, la scène ne comptant qu'une vingtaine de corps.
common/physics_ticks_per_second=90
3d/default_gravity=24.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; Le web ne supporte que WebGL2 : Vulkan y est indisponible.
renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.29, 0.5, 0.71, 1)
