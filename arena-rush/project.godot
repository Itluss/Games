; Moteur de configuration du projet.
;
; ARENA RUSH — prototype d'arène 3D multijoueur, pensé mobile d'abord.
; Orientation paysage, renderer « mobile », 60 FPS visés sur tablette.

config_version=5

[application]

config/name="Arena Rush"
config/description="Prototype d'arène 3D multijoueur — survie, loot d'armes, dernier survivant."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]

Cfg="*res://scripts/core/cfg.gd"
Registry="*res://scripts/core/registry.gd"
Pool="*res://scripts/core/pool.gd"
Fx="*res://scripts/core/fx.gd"
Sfx="*res://scripts/core/sfx.gd"
Net="*res://scripts/multiplayer/multiplayer_manager.gd"
MatchDirector="*res://scripts/core/match_manager.gd"
Profil="*res://scripts/progression/profil_joueur.gd"
Respawn="*res://scripts/core/respawn_manager.gd"
PrimeDirector="*res://scripts/objectifs/prime_director.gd"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0

[display]

; Paysage imposé : toute l'interface est conçue pour ce ratio.
window/size/viewport_width=1280
; Rendu à la densité RÉELLE de l'écran (Retina : 2-3 pixels physiques par
; pixel logique). C'est la valeur par défaut du moteur, mais elle est trop
; lourde de conséquences pour rester implicite : sans elle, le navigateur
; étire un rendu 1× et TOUT devient flou-pixelisé, quel que soit le reste.
window/dpi/allow_hidpi=true
window/size/viewport_height=720
window/size/resizable=true
; « canvas_items » + « expand » : l'interface garde sa taille physique et
; les bords gagnés sur un écran plus large deviennent du champ de vision,
; ce qui est exactement ce qu'on veut d'un téléphone à un iPad.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/vsync/vsync_mode=1

